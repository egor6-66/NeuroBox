# Образец окружения. Скопируй в .env и правь — .env в гит не попадает никогда.
#
# Здесь только то, что сервис действительно читает. Переменная, которую никто не читает, выглядит
# рабочей ручкой и врёт: настройка появляется вместе с кодом, который её использует.

PROJECT_NAME=NeuroBox

# local — вход открыт, поднять у себя можно одной командой.
# Любое другое значение требует ACCESS_TOKEN и без него сервис не поднимется.
ENVIRONMENT=local

# Общий токен доступа. Только латиница и знаки: он ездит в заголовке HTTP.
# Придумать свой: openssl rand -hex 24
ACCESS_TOKEN=

# Порт, на котором сервис виден с хоста. Внутри контейнера он всегда 8000.
API_PORT=8000

# Порт пульта. Сервис он видит через себя же, так что открывать API наружу не обязательно.
CONSOLE_PORT=3100

# Сколько миллисекунд процесс агента живёт без работы, прежде чем погаснуть. Беседа гашение
# переживает (--resume), теряется только состояние MCP-серверов. 0 — не гасить вовсе.
AGENT_SESSION_IDLE_MS=1800000

# --- База --------------------------------------------------------------------------------
# Имена совпадают с compose: на чистом клоне сервис находит базу без правки.
POSTGRES_USER=neurobox
POSTGRES_PASSWORD=neurobox
POSTGRES_DB=neurobox
DATABASE_URL=postgresql+asyncpg://neurobox:neurobox@db:5432/neurobox

# --- Токены MCP-серверов -----------------------------------------------------------------
# Сюда же кладутся токены, на которые ссылается config/mcp.json через ${VAR}. Имя переменной
# придумывает тот, кто добавляет сервер, — сервис его не знает и не обязан знать.
# Нет переменной — сервер не поднимется, и это заметная поломка, а не тихая.
#
# WINDSHIFT_TOKEN=

# --- Зона скинов --------------------------------------------------------------------------
# Адрес MCP скинов, на который ссылается config/mcp.json. По умолчанию — сосед из compose
# (сайдкар собирает его из omnifield/probe-web). Кто гоняет MCP у себя на машине через
# `pnpm serve`, ставит http://host.docker.internal:8788/mcp.
SKIN_MCP_URL=http://skin-mcp:8788/mcp
