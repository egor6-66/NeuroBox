# Секреты — образец лежит в .env.example, реальные значения не коммитятся никогда
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node — сайдкар и пульт
node_modules/
dist/
.turbo/

# Локальные данные контейнеров
data/
*.sqlite
*.sqlite3

# Редакторы и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db

# Черновики проверок: файлы, в которые пишутся живые прогоны, чтобы не ловить
# кодировку windows-консоли. В репозитории им делать нечего.
/v.txt
/sid.txt
/a.txt
/c.txt
/probe.txt
